{
  "explanation": "振幅A=2的一维简谐运动：点P沿x轴往复振动，角频率ω与时间t可调，可观察轨迹。",
  "commands": [
    {
      "op": "slider",
      "name": "amp",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "value": 2,
      "unit": "m",
      "label": "振幅"
    },
    {
      "op": "slider",
      "name": "omega",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "unit": "rad/s",
      "label": "角频率"
    },
    {
      "op": "slider",
      "name": "t",
      "min": 0,
      "max": 10,
      "step": 0.02,
      "value": 0,
      "unit": "s",
      "label": "时间"
    },
    {
      "op": "eval",
      "cmd": "P = (amp*cos(omega*t), 0)"
    },
    {
      "op": "eval",
      "cmd": "leftPoint = (-amp, 0)"
    },
    {
      "op": "eval",
      "cmd": "rightPoint = (amp, 0)"
    },
    {
      "op": "eval",
      "cmd": "axis = Segment(leftPoint, rightPoint)"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#e53935"
    },
    {
      "op": "physicsTrace",
      "target": "P",
      "mode": "trail"
    },
    {
      "op": "view",
      "xmin": -6,
      "xmax": 6,
      "ymin": -2,
      "ymax": 2
    },
    {
      "op": "animate",
      "target": "t",
      "speed": 1,
      "on": true,
      "repeat": "increasing"
    }
  ]
}