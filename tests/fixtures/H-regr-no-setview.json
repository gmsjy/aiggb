{
  "explanation": "创建半径为 r、高为 h 的圆柱，r、h 为滑动条可调；用 view 适配坐标范围，可用鼠标拖拽旋转视角。",
  "commands": [
    {
      "op": "slider",
      "name": "r",
      "min": 0.5,
      "max": 4,
      "step": 0.1,
      "value": 2
    },
    {
      "op": "slider",
      "name": "h",
      "min": 0.5,
      "max": 6,
      "step": 0.1,
      "value": 3
    },
    {
      "op": "eval",
      "cmd": "A=(0,0,0)"
    },
    {
      "op": "eval",
      "cmd": "B=(0,0,h)"
    },
    {
      "op": "eval",
      "cmd": "cyl = Cylinder(A, B, r)"
    },
    {
      "op": "style",
      "target": "cyl",
      "color": "#90CAF9",
      "opacity": 0.3
    },
    {
      "op": "view",
      "xmin": -5,
      "xmax": 5,
      "ymin": -5,
      "ymax": 5
    }
  ]
}