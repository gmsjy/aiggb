{
  "explanation": "正电荷在均匀磁场中受洛伦兹力做匀速圆周运动：F=qvB，r=mv/(qB)，T=2πm/(qB)。磁场垂直纸面向里（×）。拖动滑块调节参数。",
  "commands": [
    {
      "op": "slider",
      "name": "q",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "unit": "C",
      "label": "电荷量 q"
    },
    {
      "op": "slider",
      "name": "m",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "unit": "kg",
      "label": "质量 m"
    },
    {
      "op": "slider",
      "name": "bField",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "unit": "T",
      "label": "磁感应强度 B"
    },
    {
      "op": "slider",
      "name": "speed",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 3,
      "unit": "m/s",
      "label": "初速度 v"
    },
    {
      "op": "slider",
      "name": "t",
      "min": 0,
      "max": 10,
      "step": 0.01,
      "value": 0,
      "unit": "s",
      "label": "时间 t"
    },
    {
      "op": "eval",
      "cmd": "r = m*speed/(q*bField)"
    },
    {
      "op": "eval",
      "cmd": "omega = q*bField/m"
    },
    {
      "op": "eval",
      "cmd": "O = (0,0)"
    },
    {
      "op": "eval",
      "cmd": "P = (r*cos(omega*t), r*sin(omega*t))"
    },
    {
      "op": "eval",
      "cmd": "orbit = Circle(O, r)"
    },
    {
      "op": "eval",
      "cmd": "scaleV = 0.2"
    },
    {
      "op": "vector",
      "name": "vArrow",
      "from": "P",
      "to": "P + (-r*omega*sin(omega*t)*scaleV, r*omega*cos(omega*t)*scaleV)",
      "color": "#2196f3",
      "label": "v"
    },
    {
      "op": "eval",
      "cmd": "aMag = omega^2 * r"
    },
    {
      "op": "eval",
      "cmd": "scaleF = 0.1"
    },
    {
      "op": "vector",
      "name": "fArrow",
      "from": "P",
      "to": "P + (O - P)/r * aMag * scaleF",
      "color": "#e53935",
      "label": "F"
    },
    {
      "op": "eval",
      "cmd": "SetPointSize(P, 5)"
    },
    {
      "op": "physicsTrace",
      "target": "P",
      "mode": "trail"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#ff9800"
    },
    {
      "op": "style",
      "target": "orbit",
      "color": "#757575",
      "thickness": 1,
      "opacity": 0.5,
      "dashed": true
    },
    {
      "op": "unitAxes",
      "xUnit": "m",
      "yUnit": "m",
      "xLabel": "x/m",
      "yLabel": "y/m"
    },
    {
      "op": "view",
      "xmin": -8,
      "xmax": 8,
      "ymin": -8,
      "ymax": 8
    },
    {
      "op": "animate",
      "target": "t",
      "speed": 1,
      "on": true,
      "repeat": "increasing"
    }
  ]
}