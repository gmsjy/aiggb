{
  "explanation": "当前为2D模式，无法直接绘制三维曲面，故用等高线图表示 z=x^2+y^2。拖动滑块 c 可观察不同高度的截线。",
  "commands": [
    {
      "op": "slider",
      "name": "c",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "label": "z = c"
    },
    {
      "op": "eval",
      "cmd": "con = Circle((0,0), sqrt(c))"
    },
    {
      "op": "eval",
      "cmd": "cs = Sequence(Circle((0,0), sqrt(i)), i, 1, 5, 1)"
    },
    {
      "op": "style",
      "target": "con",
      "color": "#e53935",
      "thickness": 3
    },
    {
      "op": "style",
      "target": "cs",
      "color": "#42a5f5",
      "opacity": 0.5
    },
    {
      "op": "view",
      "xmin": -3,
      "xmax": 3,
      "ymin": -3,
      "ymax": 3
    }
  ]
}