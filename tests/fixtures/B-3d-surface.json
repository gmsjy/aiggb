{
  "explanation": "绘制旋转抛物面 z=x^2+y^2，滑块 a 控制参数范围，透明度显示网格。",
  "commands": [
    {
      "op": "slider",
      "name": "a",
      "min": 0.5,
      "max": 5,
      "step": 0.1,
      "value": 3,
      "label": "范围"
    },
    {
      "op": "eval",
      "cmd": "surface = Surface(u, v, u^2+v^2, u, -a, a, v, -a, a)"
    },
    {
      "op": "style",
      "target": "surface",
      "color": "#90CAF9",
      "opacity": 0.3
    },
    {
      "op": "view",
      "xmin": -5,
      "xmax": 5,
      "ymin": -5,
      "ymax": 5
    }
  ]
}