{
  "explanation": "本演示实现简谐运动，振幅默认设为0，可拖动滑块调节振幅、角频率并观察运动轨迹。",
  "commands": [
    {
      "op": "slider",
      "name": "amp",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "value": 0,
      "unit": "",
      "label": "振幅"
    },
    {
      "op": "slider",
      "name": "omega",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 1,
      "unit": "rad/s",
      "label": "角频率"
    },
    {
      "op": "slider",
      "name": "t",
      "min": 0,
      "max": 20,
      "step": 0.05,
      "value": 0,
      "unit": "s",
      "label": "时间"
    },
    {
      "op": "eval",
      "cmd": "P = (amp*sin(omega*t), 0)"
    },
    {
      "op": "physicsTrace",
      "target": "P",
      "mode": "trail"
    },
    {
      "op": "unitAxes",
      "xUnit": "m",
      "yUnit": "m"
    },
    {
      "op": "view",
      "xmin": -6,
      "xmax": 6,
      "ymin": -2,
      "ymax": 2
    },
    {
      "op": "animate",
      "target": "t",
      "speed": 0.5,
      "on": true,
      "repeat": "increasing"
    }
  ]
}