{
  "explanation": "由AB=3，BC=4，CA=5，取A(0,0)，B(3,0)，C(3,4)构成直角三角形，并标注三边长度。",
  "commands": [
    {
      "op": "eval",
      "cmd": "A = (0,0)"
    },
    {
      "op": "eval",
      "cmd": "B = (3,0)"
    },
    {
      "op": "eval",
      "cmd": "C = (3,4)"
    },
    {
      "op": "eval",
      "cmd": "tri = Polygon(A,B,C)"
    },
    {
      "op": "eval",
      "cmd": "sAB = Segment(A,B)"
    },
    {
      "op": "eval",
      "cmd": "sBC = Segment(B,C)"
    },
    {
      "op": "eval",
      "cmd": "sCA = Segment(C,A)"
    },
    {
      "op": "eval",
      "cmd": "SetCaption(sAB, \"3\")"
    },
    {
      "op": "eval",
      "cmd": "SetCaption(sBC, \"4\")"
    },
    {
      "op": "eval",
      "cmd": "SetCaption(sCA, \"5\")"
    },
    {
      "op": "eval",
      "cmd": "ShowLabel(sAB, true)"
    },
    {
      "op": "eval",
      "cmd": "ShowLabel(sBC, true)"
    },
    {
      "op": "eval",
      "cmd": "ShowLabel(sCA, true)"
    },
    {
      "op": "style",
      "target": "sAB",
      "color": "#000000",
      "thickness": 2
    },
    {
      "op": "style",
      "target": "sBC",
      "color": "#000000",
      "thickness": 2
    },
    {
      "op": "style",
      "target": "sCA",
      "color": "#000000",
      "thickness": 2
    }
  ]
}