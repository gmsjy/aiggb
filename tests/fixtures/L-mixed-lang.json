{
  "explanation": "已生成振幅 a=2、频率 freq=3 的正弦波 f(x)=a sin(2π freq x)，可拖动滑块调节参数。",
  "commands": [
    {
      "op": "slider",
      "name": "a",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 2,
      "label": "振幅"
    },
    {
      "op": "slider",
      "name": "freq",
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "value": 3,
      "label": "频率"
    },
    {
      "op": "eval",
      "cmd": "f(x) = a*sin(2*pi*freq*x)"
    },
    {
      "op": "style",
      "target": "f",
      "color": "#d32f2f",
      "thickness": 3
    },
    {
      "op": "view",
      "xmin": -1.2,
      "xmax": 1.8,
      "ymin": -3,
      "ymax": 3
    }
  ]
}