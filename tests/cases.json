    {
      "id": "E-regression-point-plus-point",
      "category": "regression",
      "description": "禁止 Gvec=Point 后 block+Gvec",
      "input": "在 block 点画一个竖直向下的重力矢量",
      "domain": "physics",
      "context": {
        "existingObjects": [
          "block",
          "m",
          "g"
        ]
      },
      "expected": {
        "mustNotPatterns": [
          "(?<=\\n)\\s*\\w+\\s*=\\s*\\([^)]*\\)[^\\n]*\\n[^\\n]*Vector\\([^,]+,\\s*[^+]+\\+\\s*\\w+\\s*\\)"
        ],
        "executeSuccessRate": 1
      }
    },
