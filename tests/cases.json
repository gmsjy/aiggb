      "domain": "physics",
      "expected": {
        "mustNotPatterns": [
          "\\(\\s*\\(\\s*\\w+\\s*-\\s*\\w+\\s*\\)\\s*\\^\\s*2\\s*\\+\\s*\\w+\\s*\\^\\s*2\\s*\\)\\s*\\^\\s*1\\.?5(?![^)]*\\+\\s*0\\.0)"
        ],
        "executeSuccessRate": 1
      }
    },
    {
      "id": "E-regression-naming-v",
      "category": "regression",
