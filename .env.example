# AiGGB 测试密钥配置
# 复制此文件为 .env 后填入真实值（.env 已被 .gitignore 排除，不会提交）
# cp .env.example .env

# DeepSeek API Key（必填，用于漂移监控和在线测试）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# 可选值：deepseek-v4-flash | deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek API 地址（可选，默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 测试温度（可选，默认 0.05，低温度保证可复现）
TEST_TEMPERATURE=0.05

# 漂移监控重复次数（可选，默认 10）
DRIFT_N=10

# 漂移监控采样用例数（可选，默认 6）
DRIFT_SAMPLE=6

# 测试类别过滤（可选，如 physics,regression）
# TEST_CATEGORY=regression
