        {
          "op": "style",
          "target": "P",
          "color": "#C62828",
          "pointSize": 6
        },
        {
          "op": "style",
          "target": "vline",
          "color": "#BDBDBD",
          "dashed": true
        },
        {
          "op": "style",
          "target": "eq",
          "color": "#9E9E9E",
