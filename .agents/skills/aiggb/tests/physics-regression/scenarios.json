        },
        {
          "op": "style",
          "target": "G",
          "color": "#C62828",
          "thickness": 4
        },
        {
          "op": "style",
          "target": "N",
          "color": "#2E7D32",
          "thickness": 4
        },
        {
          "op": "style",
          "target": "f",
          "color": "#EF6C00",
          "thickness": 4
        }
      ]
    },
    {
      "id": "P8",
      "name": "追及相遇（两车运动+相遇点标记）",
      "expect": [
        "v1",
        "v2",
        "t",
        "A",
        "B",
        "tm",
        "Mpt"
      ],
      "cmds": [
        {
          "op": "view",
          "xmin": -2,
          "xmax": 45,
          "ymin": -1,
          "ymax": 4
        },
        {
          "op": "eval",
          "cmd": "v1 = Slider(5, 20, 1)"
        },
        {
          "op": "eval",
          "cmd": "v2 = Slider(5, 20, 1)"
        },
        {
          "op": "eval",
          "cmd": "t = Slider(0, 20, 0.05)"
        },
        {
          "op": "eval",
          "cmd": "SetValue(v1, 10)"
        },
        {
          "op": "eval",
          "cmd": "SetValue(v2, 15)"
        },
        {
          "op": "eval",
          "cmd": "xA = v1*t"
        },
        {
          "op": "eval",
          "cmd": "xB = If(t > 2, v2*(t - 2), 0)"
        },
        {
          "op": "eval",
          "cmd": "A = (xA, 1)"
        },
        {
          "op": "eval",
          "cmd": "B = (xB, 2)"
        },
        {
          "op": "eval",
          "cmd": "laneA = Segment((0, 1), (45, 1))"
        },
        {
          "op": "eval",
          "cmd": "laneB = Segment((0, 2), (45, 2))"
        },
        {
          "op": "eval",
          "cmd": "tm = 2*v2/(v2 - v1 + 0.001)"
        },
        {
          "op": "eval",
          "cmd": "Mpt = (v1*tm, 1.5)"
        },
        {
          "op": "eval",
          "cmd": "StartAnimation(t)"
        },
        {
          "op": "style",
          "target": "A",
          "color": "#C62828",
          "pointSize": 6
        },
        {
          "op": "style",
          "target": "B",
          "color": "#1565C0",
          "pointSize": 6
        },
        {
          "op": "style",
          "target": "laneA",
          "color": "#BDBDBD",
          "dashed": true
        },
        {
          "op": "style",
          "target": "laneB",
          "color": "#BDBDBD",
          "dashed": true
        },
        {
          "op": "style",
          "target": "Mpt",
          "color": "#2E7D32",
          "pointSize": 5
        }
      ]
    },
