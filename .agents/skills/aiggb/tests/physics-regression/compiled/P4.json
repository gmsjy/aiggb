{
  "commands": [
    {
      "op": "constants",
      "names": [
        "g"
      ]
    },
    {
      "op": "slider",
      "name": "L",
      "min": 0.3,
      "max": 3,
      "step": 0.05,
      "value": 1,
      "unit": "m",
      "label": "摆长"
    },
    {
      "op": "slider",
      "name": "theta0",
      "min": 0.05,
      "max": 1.0472,
      "step": 0.01,
      "value": 0.5236,
      "unit": "rad",
      "label": "初始摆角"
    },
    {
      "op": "slider",
      "name": "t",
      "min": 0,
      "max": 10,
      "step": 0.02,
      "value": 0,
      "unit": "s",
      "label": "时间"
    },
    {
      "op": "eval",
      "cmd": "O=(0,0)"
    },
    {
      "op": "style",
      "target": "O",
      "color": "#616161",
      "pointSize": 3
    },
    {
      "op": "eval",
      "cmd": "omega=sqrt(g/L)"
    },
    {
      "op": "eval",
      "cmd": "theta=theta0*cos(omega*t)"
    },
    {
      "op": "eval",
      "cmd": "P=(L*sin(theta),-L*cos(theta))"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#e53935",
      "pointSize": 5
    },
    {
      "op": "eval",
      "cmd": "pendSeg=Segment(O,P)"
    },
    {
      "op": "style",
      "target": "pendSeg",
      "color": "#616161",
      "thickness": 2
    },
    {
      "op": "eval",
      "cmd": "refSeg=Segment(O,(0,-L))"
    },
    {
      "op": "style",
      "target": "refSeg",
      "color": "#9e9e9e",
      "dashed": true
    },
    {
      "op": "eval",
      "cmd": "PmaxR=(L*sin(theta0),-L*cos(theta0))"
    },
    {
      "op": "eval",
      "cmd": "PmaxL=(-L*sin(theta0),-L*cos(theta0))"
    },
    {
      "op": "eval",
      "cmd": "bndR=Segment(O,PmaxR)"
    },
    {
      "op": "style",
      "target": "bndR",
      "color": "#9e9e9e",
      "dashed": true
    },
    {
      "op": "eval",
      "cmd": "bndL=Segment(O,PmaxL)"
    },
    {
      "op": "style",
      "target": "bndL",
      "color": "#9e9e9e",
      "dashed": true
    },
    {
      "op": "eval",
      "cmd": "angArc=CircumcircleArc((0,-0.25*L),P,(0,-L))"
    },
    {
      "op": "style",
      "target": "angArc",
      "color": "#fb8c00",
      "thickness": 2
    },
    {
      "op": "trace",
      "target": "P",
      "on": true
    },
    {
      "op": "style",
      "target": "P",
      "color": "#1e88e5"
    },
    {
      "op": "unitAxes",
      "xUnit": "m",
      "yUnit": "m",
      "xLabel": "x/m",
      "yLabel": "y/m"
    },
    {
      "op": "view",
      "xmin": -3.5,
      "xmax": 3.5,
      "ymin": -3.5,
      "ymax": 0.5
    },
    {
      "op": "animate",
      "target": "t",
      "speed": 0.5,
      "on": true,
      "repeat": "increasing"
    }
  ]
}