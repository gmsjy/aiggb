{
  "commands": [
    {
      "op": "slider",
      "name": "theta",
      "min": 0,
      "max": 6.283,
      "step": 0.01,
      "value": 0,
      "unit": "rad",
      "label": "θ"
    },
    {
      "op": "slider",
      "name": "r",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "value": 1,
      "label": "半径 r"
    },
    {
      "op": "slider",
      "name": "omega",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "value": 1,
      "unit": "rad/s",
      "label": "角速度 ω"
    },
    {
      "op": "eval",
      "cmd": "O=(0,0)"
    },
    {
      "op": "eval",
      "cmd": "c1=Circle(O,r)"
    },
    {
      "op": "style",
      "target": "c1",
      "color": "#1e88e5",
      "thickness": 2
    },
    {
      "op": "eval",
      "cmd": "P=(r*cos(theta), r*sin(theta))"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#e53935",
      "pointSize": 5
    },
    {
      "op": "eval",
      "cmd": "rSeg=Segment(O,P)"
    },
    {
      "op": "style",
      "target": "rSeg",
      "color": "#1e88e5",
      "thickness": 2
    },
    {
      "op": "eval",
      "cmd": "f(x)=r*sin(x)"
    },
    {
      "op": "style",
      "target": "f",
      "color": "#43a047",
      "thickness": 2
    },
    {
      "op": "eval",
      "cmd": "Q=(theta, r*sin(theta))"
    },
    {
      "op": "style",
      "target": "Q",
      "color": "#fb8c00",
      "pointSize": 5
    },
    {
      "op": "eval",
      "cmd": "hSeg=Segment(P,Q)"
    },
    {
      "op": "style",
      "target": "hSeg",
      "color": "#9e9e9e",
      "dashed": true
    },
    {
      "op": "eval",
      "cmd": "Qx=(theta,0)"
    },
    {
      "op": "eval",
      "cmd": "vSeg=Segment(Q,Qx)"
    },
    {
      "op": "style",
      "target": "vSeg",
      "color": "#9e9e9e",
      "dashed": true
    },
    {
      "op": "eval",
      "cmd": "angArc=Angle(O, (1,0), P)"
    },
    {
      "op": "style",
      "target": "angArc",
      "color": "#e53935",
      "thickness": 2
    },
    {
      "op": "trace",
      "target": "Q",
      "on": true
    },
    {
      "op": "view",
      "xmin": -2,
      "xmax": 8,
      "ymin": -2,
      "ymax": 2
    },
    {
      "op": "animate",
      "target": "theta",
      "speed": 1,
      "on": true,
      "repeat": "increasing"
    }
  ]
}