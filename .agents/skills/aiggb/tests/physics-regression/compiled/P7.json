{
  "ok": true,
  "spec": "{\n  \"spec\": \"① 场景：斜面上物体受力分析（物体沿斜面下滑）\\n② 参数：θ=π/6 rad（0.1~1.4 step0.01，斜面倾角，可调）、m=2 kg（0.5~10 step0.1，可调）、μ=0.3（0~1 step0.01，动摩擦因数，可调）、s=0 m（0~5 step0.02，物体沿斜面下滑位移，可调）、t=0 s（0~5 step0.02，动画时间）\\n③ 构造：\\n",
  "commands": [
    {
      "op": "slider",
      "name": "theta",
      "min": 0.1,
      "max": 1.4,
      "step": 0.01,
      "value": 0.5236,
      "unit": "rad",
      "label": "倾角θ"
    },
    {
      "op": "slider",
      "name": "m",
      "min": 0.5,
      "max": 10,
      "step": 0.1,
      "value": 2,
      "unit": "kg",
      "label": "质量m"
    },
    {
      "op": "slider",
      "name": "mu",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "value": 0.3,
      "label": "摩擦因数μ"
    },
    {
      "op": "slider",
      "name": "t",
      "min": 0,
      "max": 5,
      "step": 0.02,
      "value": 0,
      "unit": "s",
      "label": "时间t"
    },
    {
      "op": "eval",
      "cmd": "g=9.8"
    },
    {
      "op": "eval",
      "cmd": "L=5"
    },
    {
      "op": "eval",
      "cmd": "k=5"
    },
    {
      "op": "eval",
      "cmd": "G=m*g"
    },
    {
      "op": "eval",
      "cmd": "acc=g*(sin(theta)-mu*cos(theta))"
    },
    {
      "op": "eval",
      "cmd": "s=If(acc>0, 0.5*acc*t^2, 0)"
    },
    {
      "op": "eval",
      "cmd": "O=(0,0)"
    },
    {
      "op": "eval",
      "cmd": "B=(L*cos(theta),0)"
    },
    {
      "op": "eval",
      "cmd": "A=(0,L*sin(theta))"
    },
    {
      "op": "eval",
      "cmd": "tri=Polygon(O,B,A)"
    },
    {
      "op": "style",
      "target": "tri",
      "color": "#616161",
      "opacity": 0.5
    },
    {
      "op": "eval",
      "cmd": "P=(s*cos(theta), L*sin(theta)-s*sin(theta))"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#455a64",
      "pointSize": 4
    },
    {
      "op": "eval",
      "cmd": "cP=cos(theta)"
    },
    {
      "op": "eval",
      "cmd": "sP=sin(theta)"
    },
    {
      "op": "eval",
      "cmd": "h=0.2"
    },
    {
      "op": "eval",
      "cmd": "Sq1=P+(-h*cP-h*sP, h*cP-h*sP)"
    },
    {
      "op": "eval",
      "cmd": "Sq2=P+(h*cP-h*sP, h*cP+h*sP)"
    },
    {
      "op": "eval",
      "cmd": "Sq3=P+(h*cP+h*sP, -h*cP+h*sP)"
    },
    {
      "op": "eval",
      "cmd": "Sq4=P+(-h*cP+h*sP, -h*cP-h*sP)"
    },
    {
      "op": "eval",
      "cmd": "body=Polygon(Sq1,Sq2,Sq3,Sq4)"
    },
    {
      "op": "style",
      "target": "body",
      "color": "#455a64",
      "opacity": 0.85
    },
    {
      "op": "eval",
      "cmd": "Gtip=P+(0,-G/k)"
    },
    {
      "op": "vector",
      "name": "GArrow",
      "from": "P",
      "to": "Gtip",
      "color": "#e53935",
      "label": "G=mg"
    },
    {
      "op": "eval",
      "cmd": "N=m*g*cos(theta)"
    },
    {
      "op": "eval",
      "cmd": "Ntip=P+(N*sP/k, N*cP/k)"
    },
    {
      "op": "vector",
      "name": "NArrow",
      "from": "P",
      "to": "Ntip",
      "color": "#1e88e5",
      "label": "N"
    },
    {
      "op": "eval",
      "cmd": "f=If(acc>0, mu*m*g*cos(theta), m*g*sin(theta))"
    },
    {
      "op": "eval",
      "cmd": "Ftip=P+(-f*cP/k, f*sP/k)"
    },
    {
      "op": "vector",
      "name": "fArrow",
      "from": "P",
      "to": "Ftip",
      "color": "#fb8c00",
      "label": "f"
    },
    {
      "op": "eval",
      "cmd": "ang=Angle(B,O,A)"
    },
    {
      "op": "style",
      "target": "ang",
      "color": "#8e24aa",
      "thickness": 2
    },
    {
      "op": "eval",
      "cmd": "txtG=Text(\"G=mg\", Gtip+(0.2,0))"
    },
    {
      "op": "eval",
      "cmd": "txtN=Text(\"N\", Ntip+(0.2,0))"
    },
    {
      "op": "eval",
      "cmd": "txtf=Text(\"f\", Ftip+(0.2,0))"
    },
    {
      "op": "physicsTrace",
      "target": "P",
      "mode": "trail"
    },
    {
      "op": "style",
      "target": "P",
      "color": "#90caf9",
      "dashed": true
    },
    {
      "op": "unitAxes",
      "xUnit": "m",
      "yUnit": "m",
      "xLabel": "x/m",
      "yLabel": "y/m"
    },
    {
      "op": "view",
      "xmin": -1,
      "xmax": 6,
      "ymin": -1,
      "ymax": 6
    },
    {
      "op": "animate",
      "target": "t",
      "speed": 0.5,
      "on": true,
      "repeat": "increasing"
    }
  ],
  "corrections": [],
  "issues": [],
  "warnings": [],
  "issuesMessage": "",
  "rounds": 2,
  "self_check": "ok"
}
