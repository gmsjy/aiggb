{"commands":[{"op":"view","xmin":-2,"xmax":45,"ymin":-2,"ymax":28},{"op":"eval","cmd":"v0 = Slider(5, 50, 1)"},{"op":"eval","cmd":"theta = Slider(10, 80, 1)"},{"op":"eval","cmd":"t = Slider(0, 8, 0.01)"},{"op":"eval","cmd":"SetValue(v0, 20)"},{"op":"eval","cmd":"SetValue(theta, 45)"},{"op":"eval","cmd":"P = (v0*cos(theta*pi/180)*t, v0*sin(theta*pi/180)*t - 4.9*t^2)"},{"op":"eval","cmd":"T_end = 2*v0*sin(theta*pi/180)/9.8"},{"op":"eval","cmd":"traj = Curve(v0*cos(theta*pi/180)*u, v0*sin(theta*pi/180)*u - 4.9*u^2, u, 0, T_end)"},{"op":"eval","cmd":"vVec = Vector(P, P + (v0*cos(theta*pi/180), v0*sin(theta*pi/180) - 9.8*t))"},{"op":"eval","cmd":"SetTrace(P, true)"},{"op":"eval","cmd":"StartAnimation(t)"},{"op":"style","target":"traj","color":"#1565C0","thickness":3},{"op":"style","target":"P","color":"#C62828","pointSize":6},{"op":"style","target":"vVec","color":"#2E7D32","thickness":4}]}