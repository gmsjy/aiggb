{
  "name": "aiggb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 驱动的 GeoGebra 动态图像生成器（数学 / 物理）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint .",
    "test:unit": "node --test --import tsx tests/specCache.test.ts tests/pipeline.test.ts tests/ggbBridge.test.ts tests/ggbKB.test.ts tests/toolExecutor.test.ts tests/agentLoop.test.ts tests/agentSmoke.test.ts tests/satisfactionEval.test.ts tests/sessionStore.test.ts tests/trainingStore.test.ts tests/trajectory-replay.test.ts tests/trapStore.test.ts tests/runControl.test.ts tests/problemSchema.test.ts tests/imageInput.test.ts",
    "test:replay": "tsx tests/runner.ts",
    "test:trajectory": "tsx tests/trajectory-replay.ts",
    "test:e2e": "tsx tests/euclid-e2e.ts",
    "test:record": "cross-env TEST_MODE=record tsx tests/runner.ts",
    "test:smoke": "cross-env TEST_MODE=smoke tsx tests/runner.ts",
    "test:drift": "cross-env DRIFT_BASELINE=0 tsx tests/drift-monitor.ts",
    "test:ab": "tsx tests/ab-think.ts",
    "test:baseline": "cross-env DRIFT_BASELINE=1 tsx tests/drift-monitor.ts",
    "test:hash": "tsx tests/show-hash.ts",
    "prompt:iterate": "tsx tests/prompt-iterate.ts full",
    "prompt:analyze": "tsx tests/prompt-iterate.ts analyze",
    "prompt:golden": "tsx tests/prompt-iterate.ts golden",
    "prompt:compare": "tsx tests/prompt-iterate.ts compare",
    "test:visual": "tsx tests/visual-screenshots.ts physics,dynamic,composite",
    "test:visual-all": "tsx tests/visual-screenshots.ts static,dynamic,physics,modify,composite"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.0.0",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.3.0"
  }
}
